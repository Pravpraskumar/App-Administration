{
  "name": "designer-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise multi-tenant administration platform (core backend, frontend, shared contracts).",
  "license": "UNLICENSED",
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "packages/shared",
    "apps/core-backend",
    "apps/frontend"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev": "concurrently -k -n core,web -c blue,cyan \"npm:dev:core\" \"npm:dev:frontend\"",
    "dev:core": "npm run start:dev --workspace @platform/core-backend",
    "dev:frontend": "npm run dev --workspace @platform/frontend",
    "start:prod:core": "npm run start:prod --workspace @platform/core-backend",
    "start:prod:frontend": "npm run start:prod --workspace @platform/frontend",
    "start:prod": "concurrently -k -n core,web -c blue,cyan \"npm:start:prod:core\" \"npm:start:prod:frontend\"",
    "db:core:migrate": "npm run db:migrate --workspace @platform/core-backend",
    "db:core:seed": "npm run db:seed --workspace @platform/core-backend",
    "db:generate:all": "npm run db:generate --workspaces --if-present",
    "db:migrate:all": "npm run db:migrate --workspaces --if-present",
    "db:setup": "npm run db:migrate:all && npm run db:core:seed",
    "db:reset:core": "npm run db:reset --workspace @platform/core-backend",
    "db:reset": "npm run db:reset:core && npm run db:migrate:all && npm run db:core:seed",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.0.1",
    "turbo": "^2.11.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@typespec/ts-http-runtime": "0.3.4"
  },
  "overrides": {
    "@typespec/ts-http-runtime": "0.3.4"
  }
}
