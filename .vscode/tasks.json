{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Validate Signit integration backend",
			"type": "shell",
			"command": "C:\\Program Files\\nodejs\\npm.cmd",
			"args": [
				"exec",
				"--workspace",
				"@platform/core-backend",
				"--",
				"tsc",
				"--noEmit"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		},
		{
			"label": "Generate Signit webhook migration",
			"type": "shell",
			"command": "C:\\Program Files\\nodejs\\npm.cmd",
			"args": [
				"run",
				"db:generate",
				"--workspace",
				"@platform/core-backend"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Apply Signit webhook migration",
			"type": "shell",
			"command": "C:\\Program Files\\nodejs\\npm.cmd",
			"args": [
				"run",
				"db:migrate",
				"--workspace",
				"@platform/core-backend"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Test admin database connections",
			"type": "shell",
			"command": "C:\\Program Files\\nodejs\\npx.cmd",
			"args": [
				"playwright",
				"test",
				"admin-connections.spec.ts",
				"--output=test-results\\admin-connections"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		}
	]
}